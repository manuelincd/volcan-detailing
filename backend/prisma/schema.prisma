generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  admin
  employee
  client
}

enum AppointmentStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  role         Role     @default(client)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  appointments Appointment[] @relation("ClientAppointments")
  assignedJobs Appointment[] @relation("EmployeeAppointments")

  @@map("users")
}

model Service {
  id              Int           @id @default(autoincrement())
  name            String        @unique @db.VarChar(100)
  description     String?       @db.VarChar(500)
  durationMinutes Int           @map("duration_minutes")
  price           Decimal       @db.Decimal(10, 2)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  appointments Appointment[]

  @@map("services")
}

model TimeSlot {
  id        Int     @id @default(autoincrement())
  dayOfWeek Int     @map("day_of_week") @db.SmallInt
  startTime String  @map("start_time") @db.VarChar(5)
  endTime   String  @map("end_time") @db.VarChar(5)
  isActive  Boolean @default(true) @map("is_active")

  // one start time per day
  @@unique([dayOfWeek, startTime])
  @@index([dayOfWeek])
  @@map("time_slots")
}

model Appointment {
  id          Int               @id @default(autoincrement())
  clientId    Int               @map("client_id")
  employeeId  Int?              @map("employee_id")
  serviceId   Int               @map("service_id")
  vehicleType String            @map("vehicle_type") @db.VarChar(50)
  date        DateTime          @db.Date
  timeSlot    String            @map("time_slot") @db.VarChar(5)
  status      AppointmentStatus @default(pending)
  notes       String?           @db.VarChar(500)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  client   User    @relation("ClientAppointments", fields: [clientId], references: [id])
  employee User?   @relation("EmployeeAppointments", fields: [employeeId], references: [id])
  service  Service @relation(fields: [serviceId], references: [id])

  @@index([clientId])
  @@index([employeeId])
  @@index([serviceId])
  @@index([date])
  @@index([status])
  @@map("appointments")
}
